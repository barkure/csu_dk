# ========== 服务 ==========
# HTTP 监听：本机 127.0.0.1:8443，业务时区为上海
CSU_DK_HOST=127.0.0.1
CSU_DK_PORT=8443
CSU_DK_TZ=Asia/Shanghai

# ========== 邮件 ==========
# 腾讯云 SES：子账号密钥、地域、模板和已验证的发件人
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
# 邮件模板 ID；模板正文需要包含 {{code}} 和 {{minutes}}
TENCENT_SES_TEMPLATE_ID=
MAIL_FROM=Barkure <no-reply@barkure.cn>

# ========== 用户与会话 ==========
# 邮箱白名单留空不限制；每人最多 5 个账号、5 个会话，会话保留 14 天
CSU_DK_ALLOWED_EMAILS=
CSU_DK_MAX_ACCOUNTS=5
CSU_DK_MAX_SESSIONS=5
CSU_DK_SESSION_DAYS=14

# ========== 邮箱验证码 ==========
# 验证码有效 10 分钟，同一邮箱间隔 60 秒
CSU_DK_CODE_MINUTES=10
CSU_DK_CODE_COOLDOWN=60
# 每日验证码请求上限；同一 IP 和同一邮箱分别计数，均采用此上限
CSU_DK_LOGIN_CODE_DAILY_MAX=10
# 同一 IP 每 30 分钟最多校验 5 次验证码
CSU_DK_LOGIN_CODE_VERIFY_MAX=5

# ========== 自动打卡 ==========
# 每天 20:00–23:30 自动打卡，时间窗可以跨午夜
CSU_DK_CHECKIN_WINDOW_START=20:00
CSU_DK_CHECKIN_WINDOW_END=23:30
# 每 10 秒扫描一次待执行任务
CSU_DK_SCHED_INTERVAL=10
# 打卡时段内，每轮随机执行 2 个账号
CSU_DK_CHECKIN_PER_TICK=2
# 非打卡时段，每 5 秒刷新 1 个账号的登录状态
CSU_DK_REFRESH_INTERVAL=5
# 每 600 秒清理过期验证码、网页会话和超期打卡记录
CSU_DK_MAINTENANCE_INTERVAL=600
# 打卡记录保留 10 天
CSU_DK_RECORD_RETENTION_DAYS=10

# ========== 学校登录风控 ==========
# 学校冻结当前出口 IP 后，切换到可用出口；300 秒后重新尝试原出口
CSU_DK_IP_FREEZE_COOLDOWN=300
# 密码错误上限：同一学号 3 次、同一用户 6 次、同一来源 IP 10 次
CSU_DK_CRED_FAIL_MAX=3
CSU_DK_CRED_FAIL_MAX_USER=6
CSU_DK_CRED_FAIL_MAX_IP=10
# 同一学号、用户或来源 IP 的密码错误次数达到对应上限后，暂停 900 秒
CSU_DK_CRED_FAIL_COOLDOWN=900
# CAS 登录：并发 1，每分钟最多 8 次；用户验证同一学号至少间隔 15 秒
CSU_DK_CAS_CONCURRENCY=1
CSU_DK_CAS_LOGIN_PER_MINUTE=8
CSU_DK_CAS_ATTEMPT_GAP=15
# 手动重新登录同一账号至少间隔 60 秒
CSU_DK_RELOGIN_COOLDOWN=60

# ========== 反向代理 ==========
# 是否信任 X-Forwarded-For；仅当请求经过可信反向代理时设为 true
CSU_DK_TRUST_PROXY=false
# 生产环境使用 HTTPS，应为会话 Cookie 添加 Secure 属性；本地使用明文 HTTP 时设为 false
CSU_DK_COOKIE_SECURE=true

# ========== 校园网出口 ==========
# 访问校园网所用的出口代理；与服务器直连一起按新会话均匀轮询，冷却中的出口自动跳过
# 多个地址用逗号分隔；仅支持带端口的 http:// 代理
# CSU_DK_PROXIES=http://127.0.0.1:1091,http://127.0.0.1:1092
