# ========== 服务 ==========
# 监听地址：127.0.0.1 仅本机可访问，0.0.0.0 允许局域网访问
CSU_DK_HOST=127.0.0.1
# 监听端口
CSU_DK_PORT=8443
# 时区：影响打卡时段与记录时间
CSU_DK_TZ=Asia/Shanghai

# ========== 邮件（登录验证码）==========
# 发信走腾讯云邮件推送（SES），下面五项都填上才真发信，缺一项就把验证码打到日志（本地调试）

# SecretId / SecretKey：控制台 → 访问管理 CAM → 访问密钥 → API 密钥管理
# 建议用子账号密钥（CAM → 用户 → 新建子用户 → 只授 QcloudSESFullAccess），主账号密钥泄露等于整个账号失守
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
# 地域：必须与邮件推送控制台所在地域一致，否则接口报错。取值：ap-guangzhou / ap-hongkong
TENCENT_SES_REGION=ap-hongkong
# 模板 ID：邮件配置 → 发信模板，审核通过后在列表里可见；模板正文用 {{code}}、{{minutes}} 两个变量占位
TENCENT_SES_TEMPLATE_ID=
# 发件人：显示名 + 一个空格 + <地址>，地址所属域名需在腾讯云完成验证，显示名里不能有冒号
MAIL_FROM=Barkure <no-reply@barkure.cn>

# ========== 访问控制 ==========
# 允许登录本服务的邮箱，逗号分隔；留空表示任何邮箱均可注册
CSU_DK_ALLOWED_EMAILS=

# ========== 账号与会话 ==========
# 每个用户可托管的学号数量上限
CSU_DK_MAX_ACCOUNTS=5
# 每个用户保留的有效会话数上限
CSU_DK_MAX_SESSIONS=10
# 会话有效期（天）
CSU_DK_SESSION_DAYS=14

# ========== 验证码 ==========
# 有效期（分钟）
CSU_DK_CODE_MINUTES=10
# 同一邮箱两次申请的最小间隔（秒）
CSU_DK_CODE_COOLDOWN=60
# 同一邮箱 24 小时内申请次数上限
CSU_DK_EMAIL_DAILY_MAX=5
# 同一来源 IP 申请验证码：统计窗口（秒）与次数上限
CSU_DK_RL_IP_WINDOW=86400
CSU_DK_RL_IP_MAX=5
# 全局发送额度：统计窗口（秒）与次数上限
CSU_DK_RL_GLOBAL_WINDOW=86400
CSU_DK_RL_GLOBAL_MAX=200
# 同一来源 IP 校验验证码：统计窗口（秒）与次数上限
CSU_DK_RL_VERIFY_WINDOW=1800
CSU_DK_RL_VERIFY_MAX=15

# ========== 打卡 ==========
# 调度扫描间隔（秒）
CSU_DK_SCHED_INTERVAL=20
# 数据清理间隔（秒）：过期验证码、会话与执行记录
CSU_DK_MAINTENANCE_INTERVAL=600
# 执行记录保留天数
CSU_DK_RECORD_RETENTION_DAYS=180
# 服务离线超过该分钟数后不再补跑当日打卡
CSU_DK_CATCHUP_MINUTES=120
# 允许的打卡时段跨度上限（小时）
CSU_DK_MAX_WINDOW=6
# 从学校时段尾部预留的安全余量（分钟）
CSU_DK_WINDOW_MARGIN=60
# 登录态兜底有效期（秒）：实际判据为同一自然日
CSU_DK_TOKEN_TTL=86400
# 学校冻结出口 IP 后的暂停登录时长（秒）
CSU_DK_IP_FREEZE_COOLDOWN=3600

# ========== 学校登录 ==========
# 密码登录的全局并发上限（学校按出口 IP 风控，建议保持 1）
CSU_DK_CAS_CONCURRENCY=1
# 同一账号两次「重新上号」的最小间隔（秒）
CSU_DK_RELOGIN_COOLDOWN=60

# ========== 反向代理 ==========
# 前置反向代理（Caddy / Nginx）时启用：依据 X-Forwarded-Proto 判断 HTTPS 并限制来源 IP
# CSU_DK_TRUST_PROXY=1
# 强制会话 Cookie 带 Secure（仅 HTTPS 部署可启用）
# CSU_DK_COOKIE_SECURE=1
